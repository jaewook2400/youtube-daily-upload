<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- install.sh 가 __DIR__ 를 저장소 절대경로로 바꿔 ~/Library/LaunchAgents 에 복사한다 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jaewook.youtube-upload</string>

    <key>ProgramArguments</key>
    <array>
        <string>__DIR__/run.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__DIR__/logs/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__DIR__/logs/launchd_stderr.log</string>
</dict>
</plist>
